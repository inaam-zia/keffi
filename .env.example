# Supabase (free at supabase.com — create a project, then copy these)
NEXT_PUBLIC_SUPABASE_URL=https://vnueqhizyysseoroojhh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for npm run db:setup /admin migrate
# Supabase → Project Settings → Database → Connection string → URI
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Admin login password (pick something strong)
ADMIN_PASSWORD=123456

# Extra password that locks the Payment QR section (optional).
# If unset, the admin password above is used to unlock it.
# PAYMENT_QR_PASSWORD=your-payment-qr-password

# Your cafe name (shown to customers)
NEXT_PUBLIC_CAFE_NAME=Keffi

# Receipt / bill (optional — defaults match Keffi printed bill)
# NEXT_PUBLIC_RECEIPT_CAFE_NAME=KEFFI
# NEXT_PUBLIC_CAFE_ADDRESS=D9A SHOP NO.19, D BLOCK MARKET,|SECTOR 27, NOIDA 201301, UTTAR|PRADESH 7017641188
# NEXT_PUBLIC_RECEIPT_CASHIER=biller

# Used for QR codes (update after Vercel deploy)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# OTP for past-order lookup (pick one SMS provider)
# Fast2SMS — https://www.fast2sms.com (OTP route, good for India)
# FAST2SMS_API_KEY=

# MSG91 — https://msg91.com (alternative)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=VERIFY

# Email OTP (free — recommended for past-order lookup)
# Resend — https://resend.com (3000 emails/month free)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Keffi <onboarding@resend.dev>

# Dev: show OTP in API response when no SMS/email key is set (auto on in development)
# OTP_DEV_MODE=true

# Sign customer session cookies (optional; falls back to ADMIN_PASSWORD)
# CUSTOMER_SESSION_SECRET=
# OTP_SECRET=
